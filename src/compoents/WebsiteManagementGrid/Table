IF OBJECT_ID('dbo.WebSite_Banner','U') IS NULL
BEGIN
    CREATE TABLE dbo.WebSite_Banner
    (
         Id              BIGINT IDENTITY(1,1) PRIMARY KEY
        ,WebsiteId       INT             NOT NULL
        ,BannerTypeId    INT             NOT NULL
        ,BannerTitle     NVARCHAR(200)   NULL
        ,BannerJson      NVARCHAR(MAX)   NULL      -- full banner config (text, link, overlay, etc.)
        ,MediaType       VARCHAR(10)     NOT NULL DEFAULT ('image')   -- 'image' | 'video' | 'gif'
        ,ImageUrl        NVARCHAR(500)   NULL
        ,MobileImageUrl  NVARCHAR(500)   NULL
        ,SortOrder       INT             NOT NULL DEFAULT (0)
        ,IsActive        BIT             NOT NULL DEFAULT (1)
        ,IsDeleted       BIT             NOT NULL DEFAULT (0)
        ,CreatedBy       NVARCHAR(100)   NULL
        ,CreatedDate     DATETIME        NOT NULL DEFAULT (GETDATE())
        ,ModifiedBy      NVARCHAR(100)   NULL
        ,ModifiedDate    DATETIME        NULL

        ,CONSTRAINT CK_WebSite_Banner_MediaType CHECK (MediaType IN ('image','video','gif'))
    )

    CREATE INDEX IX_WebSite_Banner_Lookup
        ON dbo.WebSite_Banner (WebsiteId, BannerTypeId, IsDeleted, SortOrder)
END
GO
