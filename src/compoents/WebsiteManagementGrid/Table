GO
IF OBJECT_ID('dbo.WebSite_BannerType_Config', 'U') IS NULL
BEGIN
    CREATE TABLE dbo.WebSite_BannerType_Config
    (
        id              INT IDENTITY(1,1) PRIMARY KEY,
        WebsiteId       DECIMAL(38,0)   NOT NULL,   -- FK -> WebSite_Domain_Setting.id
        BannerTypeId    INT             NOT NULL,   -- matches BANNER_TYPES.BannerTypeId
        TypeKey         NVARCHAR(100)   NULL,
        TypeName        NVARCHAR(200)   NULL,
        IsActive        BIT             NOT NULL DEFAULT (1),
        CreatedDate     DATETIME        NOT NULL DEFAULT (GETDATE()),
        CreatedBy       NVARCHAR(100)   NULL,
        ModifiedDate    DATETIME        NULL,
        ModifiedBy      NVARCHAR(100)   NULL,
        CONSTRAINT FK_WebSiteBannerType_Website
            FOREIGN KEY (WebsiteId) REFERENCES dbo.WebSite_Domain_Setting(id),
        CONSTRAINT UQ_WebSiteBannerType_Website_Type
            UNIQUE (WebsiteId, BannerTypeId)
    )
END
GO





